<%= render "shared/navbar" %>

<!-- Container do Mapa Leaflet em Tela Cheia -->
<div id="map" class="fixed inset-0 w-screen h-screen z-0 bg-slate-950" data-controller="map" data-map-target="mapContainer"></div>

<!-- Legenda Oficial de Portes (Overlay Flutuante no Canto Inferior Esquerdo) -->
<div class="absolute bottom-6 left-6 z-[1000] bg-slate-900/90 backdrop-blur-md p-4 rounded-xl border border-slate-800 shadow-xl text-xs text-white">
  <div class="flex items-center justify-between font-extrabold uppercase text-[11px] text-slate-300 border-b border-slate-800 pb-2 mb-2.5 gap-4">
    <span>Classificação por Porte</span>
    <span class="text-indigo-400">IPDA</span>
  </div>

  <div class="grid grid-cols-1 gap-2 font-semibold">
    <div class="flex items-center gap-2">
      <span class="w-3.5 h-3.5 rounded-full bg-[#3B82F6] border-2 border-white shadow-xs shrink-0"></span>
      <span class="text-slate-200">ESTADUAL</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="w-3.5 h-3.5 rounded-full bg-[#EAB308] border-2 border-white shadow-xs shrink-0"></span>
      <span class="text-slate-200">SETORIAL</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="w-3.5 h-3.5 rounded-full bg-[#F97316] border-2 border-white shadow-xs shrink-0"></span>
      <span class="text-slate-200">CENTRAL</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="w-3.5 h-3.5 rounded-full bg-[#22C55E] border-2 border-white shadow-xs shrink-0"></span>
      <span class="text-slate-200">REGIONAL</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="w-3.5 h-3.5 rounded-full bg-[#6B7280] border-2 border-white shadow-xs shrink-0"></span>
      <span class="text-slate-200">LOCAL</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="w-3.5 h-3.5 rounded-full bg-[#EC4899] border-2 border-white shadow-xs shrink-0"></span>
      <span class="text-slate-200">CASA DE ORAÇÃO</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="w-3.5 h-3.5 rounded-full bg-[#06B6D4] border-2 border-white shadow-xs shrink-0"></span>
      <span class="text-slate-200">ALDEIA INDÍGENA</span>
    </div>
  </div>
</div>

<!-- Modal/Painel de Filtros Flutuante -->
<div id="filterModal" data-map-target="filterModal" class="hidden fixed top-20 right-6 z-[2000] w-80 bg-slate-900/95 backdrop-blur-md rounded-2xl p-5 border border-slate-800 shadow-2xl text-white">
  <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
    <h3 class="text-sm font-black uppercase tracking-wider text-slate-200 flex items-center gap-2">
      <svg width="16" height="16" class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
      </svg>
      Filtros do Mapa
    </h3>
    <button type="button" data-action="click->map#toggleFilters" class="text-slate-400 hover:text-white transition-colors">
      <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <div class="space-y-4 text-xs font-semibold">
    <!-- Estado (UF) -->
    <div>
      <label class="block text-slate-400 mb-1">Estado (UF)</label>
      <select data-map-target="stateSelect" class="w-full bg-slate-800 border border-slate-700 text-white rounded-xl px-3 py-2 outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="">Todos os Estados</option>
        <option value="AC">AC</option><option value="AL">AL</option><option value="AM">AM</option><option value="AP">AP</option>
        <option value="BA">BA</option><option value="CE">CE</option><option value="DF">DF</option><option value="ES">ES</option>
        <option value="GO">GO</option><option value="MA">MA</option><option value="MG">MG</option><option value="MS">MS</option>
        <option value="MT">MT</option><option value="PA">PA</option><option value="PB">PB</option><option value="PE">PE</option>
        <option value="PI">PI</option><option value="PR">PR</option><option value="RJ">RJ</option><option value="RN">RN</option>
        <option value="RO">RO</option><option value="RR">RR</option><option value="RS">RS</option><option value="SC">SC</option>
        <option value="SE">SE</option><option value="SP">SP</option><option value="TO">TO</option>
      </select>
    </div>

    <!-- Porte da Igreja -->
    <div>
      <label class="block text-slate-400 mb-1">Porte da Igreja</label>
      <select data-map-target="porteSelect" class="w-full bg-slate-800 border border-slate-700 text-white rounded-xl px-3 py-2 outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="">Todos os Portes</option>
        <option value="ESTADUAL">Estadual</option>
        <option value="SETORIAL">Setorial</option>
        <option value="CENTRAL">Central</option>
        <option value="REGIONAL">Regional</option>
        <option value="LOCAL">Local</option>
        <option value="CASA DE ORAÇÃO">Casa de Oração</option>
        <option value="ALDEIA INDIGENA">Aldeia Indígena</option>
      </select>
    </div>

    <!-- Status de Validação -->
    <div>
      <label class="block text-slate-400 mb-1">Status de Validação</label>
      <select data-map-target="validadaSelect" class="w-full bg-slate-800 border border-slate-700 text-white rounded-xl px-3 py-2 outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="">Todas</option>
        <option value="true">Apenas Validadas</option>
        <option value="false">Pendentes</option>
      </select>
    </div>

    <!-- Ações -->
    <div class="flex items-center gap-2 pt-2">
      <button type="button" data-action="click->map#applyFilters" class="flex-1 py-2 px-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl transition-all shadow-md">
        Aplicar Filtros
      </button>
      <button type="button" data-action="click->map#clearFilters" class="py-2 px-3 bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold rounded-xl transition-all border border-slate-700">
        Limpar
      </button>
    </div>
  </div>
</div>
