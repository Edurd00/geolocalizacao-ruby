<div data-controller="map" class="relative w-screen h-screen overflow-hidden bg-slate-950">
  <%= render "shared/navbar" %>

  <!-- Container do Mapa Leaflet em Tela Cheia -->
  <div id="map" class="fixed inset-0 w-screen h-screen z-0 bg-slate-950" data-map-target="mapContainer"></div>

  <!-- Legenda de Regiões (Agrupamentos) -->
  <div id="regions-legend" class="fixed bottom-[20rem] left-6 z-[1000] max-h-[35vh] w-72 overflow-y-auto rounded-2xl border border-slate-200 bg-white p-4 text-xs text-slate-900 shadow-2xl">
    <div class="mb-3 flex items-center justify-between font-extrabold text-xs text-slate-800">
      <span class="flex items-center gap-2">
        <svg class="h-4 w-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
        🎨 REGIÕES (AGRUPAMENTOS)
      </span>
      <button type="button" onclick="document.getElementById('regions-legend').classList.add('hidden')" aria-label="Fechar legenda de regiões" class="font-bold text-slate-400 hover:text-slate-600">&times;</button>
    </div>
    <div class="grid grid-cols-2 gap-x-2 gap-y-2.5 text-[11px] font-bold">
      <div class="flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-full bg-[#f59e0b] shadow-sm"></span> SP</div>
      <div class="flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-full bg-[#ea580c] shadow-sm"></span> MG</div>
      <div class="flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-full bg-[#dc2626] shadow-sm"></span> ES / RJ</div>
      <div class="flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-full bg-[#059669] shadow-sm"></span> Norte</div>
      <div class="flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-full bg-[#2563eb] shadow-sm"></span> Sul</div>
      <div class="flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-full bg-[#9333ea] shadow-sm"></span> Nordeste</div>
      <div class="flex items-center gap-2"><span class="inline-block h-3 w-3 rounded-full bg-[#0891b2] shadow-sm"></span> Centro-Oeste</div>
    </div>
  </div>

  <!-- Legenda Oficial de Portes (Overlay Flutuante no Canto Inferior Esquerdo) -->
  <div class="absolute bottom-6 left-6 z-[1000] bg-slate-900/90 backdrop-blur-md p-4 rounded-xl border border-slate-800 shadow-xl text-xs text-white">
    <div class="flex items-center justify-between font-extrabold uppercase text-[11px] text-slate-300 border-b border-slate-800 pb-2 mb-2.5 gap-4">
      <span>Classificação por Porte</span>
      <span class="text-indigo-400">IPDA</span>
    </div>

    <div class="grid grid-cols-1 gap-2 font-semibold">
      <div class="flex items-center gap-2">
        <span class="w-3.5 h-3.5 rounded-full bg-[#3b82f6] border-2 border-white shadow-xs shrink-0"></span>
        <span class="text-slate-200">ESTADUAL</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-3.5 h-3.5 rounded-full bg-[#eab308] border-2 border-white shadow-xs shrink-0"></span>
        <span class="text-slate-200">SETORIAL</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-3.5 h-3.5 rounded-full bg-[#f97316] border-2 border-white shadow-xs shrink-0"></span>
        <span class="text-slate-200">CENTRAL</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-3.5 h-3.5 rounded-full bg-[#22c55e] border-2 border-white shadow-xs shrink-0"></span>
        <span class="text-slate-200">REGIONAL</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-3.5 h-3.5 rounded-full bg-[#64748b] border-2 border-white shadow-xs shrink-0"></span>
        <span class="text-slate-200">LOCAL</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-3.5 h-3.5 rounded-full bg-[#ec4899] border-2 border-white shadow-xs shrink-0"></span>
        <span class="text-slate-200">CASA DE ORAÇÃO</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-3.5 h-3.5 rounded-full bg-[#06b6d4] border-2 border-white shadow-xs shrink-0"></span>
        <span class="text-slate-200">ALDEIA INDÍGENA</span>
      </div>
    </div>
  </div>
</div>
