<div data-controller="map" data-map-target="filterModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
  <div class="bg-white rounded-lg p-4 w-80">
    <h2 class="text-lg font-bold mb-2">Filtros</h2>
    <div class="mb-2">
      <label class="block text-sm font-medium" for="porteFilter">Porte</label>
      <select id="porteFilter" data-map-target="porteFilter" class="mt-1 block w-full border rounded">
        <option value="">Todos</option>
        <option value="ESTADUAL">Estadual</option>
        <option value="SETORIAL">Setorial</option>
        <option value="CENTRAL">Central</option>
        <option value="REGIONAL">Regional</option>
        <option value="LOCAL">Local</option>
        <option value="CASA DE ORAÇÃO">Casa de Oração</option>
        <option value="ALDEIA INDÍGENA">Aldeia Indígena</option>
      </select>
    </div>
    <div class="mb-2">
      <label class="block text-sm font-medium" for="validadaFilter">Status</label>
      <select id="validadaFilter" data-map-target="validadaFilter" class="mt-1 block w-full border rounded">
        <option value="">Todos</option>
        <option value="true">Validada</option>
        <option value="false">Pendente</option>
      </select>
    </div>
    <div class="mb-2">
      <label class="block text-sm font-medium" for="searchInput">Buscar Igreja</label>
      <input type="text" id="searchInput" data-map-target="searchInput" data-action="input->map#search" placeholder="Nome, código, município..." class="mt-1 block w-full border rounded" />
    </div>
    <div class="flex justify-between mt-4">
      <button data-action="click->map#applyFilters" class="bg-blue-600 text-white px-3 py-1 rounded">Aplicar</button>
      <button data-action="click->map#clearFilters" class="bg-gray-300 px-3 py-1 rounded">Limpar</button>
      <button data-action="click->map#toggleFilters" class="bg-red-600 text-white px-3 py-1 rounded">Fechar</button>
    </div>
  </div>
</div>
