<div class="max-w-4xl mx-auto space-y-6">
  <!-- Back Link & Header -->
  <div class="flex items-center justify-between">
    <a href="/patrimonio" class="px-3.5 py-2 bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white rounded-xl text-xs font-bold border border-slate-800 transition-colors flex items-center gap-1.5">
      <span>← Voltar à Lista</span>
    </a>

    <span class="text-xs font-mono font-bold bg-slate-900 text-indigo-400 px-3 py-1.5 rounded-xl border border-slate-800">
      TOTVS: <%= @church.respond_to?(:codigo_totvs) ? @church.codigo_totvs : "" %>
    </span>
  </div>

  <!-- Church Identification Card -->
  <section class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-3">
    <div class="flex items-center gap-3">
      <div class="w-12 h-12 rounded-2xl bg-indigo-950 border border-indigo-800 text-indigo-400 flex items-center justify-center text-xl shrink-0">
        🏛️
      </div>
      <div>
        <span class="text-[10px] font-black uppercase tracking-wider text-indigo-400 block">Congregação Localizada</span>
        <h2 class="text-xl sm:text-2xl font-black text-white"><%= @church.nome %></h2>
        <p class="text-xs text-slate-400 mt-0.5">
          <%= @church.respond_to?(:endereco) ? @church.endereco : "" %>
          <%= " • #{@church.bairro}" if @church.respond_to?(:bairro) && @church.bairro.present? %>
          <%= " • #{@church.municipio} - #{@church.estado}" if @church.respond_to?(:municipio) && @church.municipio.present? %>
        </p>
      </div>
    </div>
  </section>

  <!-- Turbo Frame Container for Form & Turbo Stream Updates -->
  <%= turbo_frame_tag "patrimonio_form_frame" do %>
    <div id="patrimonio_notice">
      <% if flash[:notice].present? %>
        <div class="p-4 bg-emerald-950/80 border border-emerald-800 text-emerald-300 rounded-2xl font-bold text-sm flex items-center gap-2 mb-4">
          <span>✅</span>
          <span><%= flash[:notice] %></span>
        </div>
      <% end %>
    </div>

    <%= form_with(model: @asset, url: update_patrimonio_path(@church.codigo_totvs || @church.id), method: :patch, class: "space-y-6") do |f| %>
      <!-- Step 1: Responsável -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4">
        <h3 class="text-sm font-black text-white uppercase tracking-wider border-b border-slate-800 pb-3 flex items-center gap-2">
          <span class="text-indigo-400">👤</span> Dirigente Responsável pelo Inventário
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1">
              Nome do Dirigente Responsável <span class="text-rose-500">*</span>
            </label>
            <%= f.text_field :nome_responsavel, required: true, placeholder: "Ex: Pr. João Silva", class: "w-full h-11 px-4 bg-slate-800 border border-slate-700 rounded-xl text-white text-sm font-semibold outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1">
              Telefone / WhatsApp de Contato <span class="text-rose-500">*</span>
            </label>
            <%= f.telephone_field :telefone_responsavel, required: true, placeholder: "(11) 98765-4321", class: "w-full h-11 px-4 bg-slate-800 border border-slate-700 rounded-xl text-white text-sm font-mono font-bold outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>
        </div>
      </div>

      <!-- Step 2: Items List -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
          <h3 class="text-sm font-black text-white uppercase tracking-wider flex items-center gap-2">
            <span class="text-indigo-400">🪑</span> Bens e Equipamentos da Congregação
          </h3>
          <span class="text-xs font-bold bg-indigo-950 text-indigo-300 px-3 py-1 rounded-xl border border-indigo-800">
            Ano: <%= Time.current.year %>
          </span>
        </div>

        <div class="space-y-3">
          <% @asset.items.each_with_index do |item, idx| %>
            <div class="p-4 rounded-xl border border-slate-800 bg-slate-950 space-y-3">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-center gap-2">
                  <input type="hidden" name="items[<%= idx %>][item_nome]" value="<%= item.item_nome %>" />
                  <span class="text-sm font-bold text-white"><%= item.item_nome %></span>
                </div>

                <div class="flex items-center gap-3">
                  <!-- Possui Toggle -->
                  <label class="flex items-center gap-2 text-xs font-bold text-slate-300 cursor-pointer">
                    <input
                      type="checkbox"
                      name="items[<%= idx %>][possui]"
                      value="Sim"
                      <%= "checked" if item.possui == 'Sim' || item.possui == 'SIM' %>
                      class="w-4 h-4 rounded border-slate-700 bg-slate-800 text-indigo-600 focus:ring-indigo-500"
                    />
                    <span>Possui na Igreja</span>
                  </label>

                  <!-- Quantity -->
                  <div class="flex items-center gap-1">
                    <span class="text-xs text-slate-400 font-bold">Qtd:</span>
                    <input
                      type="number"
                      name="items[<%= idx %>][quantidade]"
                      value="<%= item.quantidade || 1 %>"
                      min="1"
                      class="w-16 h-9 px-2 bg-slate-800 border border-slate-700 text-white font-mono font-bold text-xs rounded-lg text-center outline-none focus:ring-2 focus:ring-indigo-500"
                    />
                  </div>

                  <!-- Conservacao -->
                  <select
                    name="items[<%= idx %>][conservacao]"
                    class="h-9 bg-slate-800 border border-slate-700 text-white font-bold text-xs rounded-lg px-2 outline-none focus:ring-2 focus:ring-indigo-500"
                  >
                    <option value="ÓTIMO" <%= "selected" if item.conservacao == "ÓTIMO" %>>Ótimo</option>
                    <option value="BOM" <%= "selected" if item.conservacao == "BOM" || item.conservacao.blank? %>>Bom</option>
                    <option value="REGULAR" <%= "selected" if item.conservacao == "REGULAR" %>>Regular</option>
                    <option value="RUIM" <%= "selected" if item.conservacao == "RUIM" %>>Ruim</option>
                  </select>
                </div>
              </div>

              <!-- Observacao -->
              <div>
                <input
                  type="text"
                  name="items[<%= idx %>][observacao]"
                  value="<%= item.observacao %>"
                  placeholder="Observações opcionais (marca, modelo, detalhes)..."
                  class="w-full h-8 px-3 bg-slate-800/80 border border-slate-700/80 text-slate-200 placeholder:text-slate-500 font-medium text-xs rounded-lg outline-none focus:ring-1 focus:ring-indigo-500"
                />
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Step 3: Observacoes Gerais e Envio -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4">
        <h3 class="text-sm font-black text-white uppercase tracking-wider border-b border-slate-800 pb-3 flex items-center gap-2">
          <span class="text-indigo-400">📝</span> Observações Finais
        </h3>

        <div>
          <%= f.text_area :observacoes, rows: 3, placeholder: "Informe observações gerais sobre as condições físicas ou materiais do templo...", class: "w-full p-4 bg-slate-800 border border-slate-700 text-white placeholder:text-slate-500 text-sm font-medium rounded-xl outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <div class="pt-2 flex justify-end">
          <%= f.submit "Salvar e Transmitir Patrimônio", class: "px-8 h-13 bg-indigo-600 hover:bg-indigo-700 text-white font-extrabold text-sm rounded-xl shadow-lg transition-all cursor-pointer flex items-center gap-2" %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
